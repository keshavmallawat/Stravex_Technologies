# Client-side environment variables (Vite).
# Only variables prefixed with VITE_ are exposed to the browser.
#
# Local development: copy this file to .env and fill in the values.
# GitHub Actions: set the same names as repository variables
# (Settings > Secrets and variables > Actions > Variables).
#
# The Firebase web configuration lives in src/lib/firebase.ts.

# Cloudinary (unsigned uploads from the admin media library)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
